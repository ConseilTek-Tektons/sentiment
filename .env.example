# Application
APP_NAME=Sentiment
APP_VERSION=development
WORKSPACE_ID=00000000-0000-4000-8000-000000000001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_DEMO_MODE=true

# PostgreSQL 16 and Redis 7
DATABASE_URL=postgres://sentiment:sentiment@localhost:5432/sentiment
DATABASE_POOL_SIZE=10
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379

# Direct OIDC or the included Keycloak SAML/OIDC broker
OIDC_PROVIDER_NAME=Enterprise SSO
OIDC_ISSUER=http://idp.localtest.me:8080/realms/sentiment
OIDC_CLIENT_ID=sentiment-web
OIDC_CLIENT_SECRET=local-dev-secret
OIDC_SCOPES=openid profile email groups
OIDC_ROLE_CLAIM=groups

# Optional AI and RAG
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_VECTOR_STORE_ID=
